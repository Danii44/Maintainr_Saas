# Maintainr SaaS — Netlify server-side production variables
# Use the Supabase connection string from the SaaS Supabase project only.
DATABASE_URL=
JWT_SECRET=
AUTH_BASE_URL=
BOOTSTRAP_MANAGER_EMAIL=

# Optional notification provider settings. Use verified provider senders only.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
# Resend dashboard webhook secret for POST /api/webhooks/resend
RESEND_WEBHOOK_SECRET=
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio sender owned by this account, in E.164 format.
TWILIO_FROM=
# Public HTTPS base URL used to validate signed callbacks behind a proxy.
NOTIFICATION_WEBHOOK_BASE_URL=
# Full public HTTPS endpoint for message delivery status callbacks.
TWILIO_STATUS_CALLBACK_URL=

# Optional S3-compatible customer media storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Required when scheduled maintenance reminders are enabled
REMINDER_CALLBACK_SECRET=
