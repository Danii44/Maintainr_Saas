# Maintainr SaaS — Netlify server-side production variables
# Use the Supabase connection string from the SaaS Supabase project only.
DATABASE_URL=
JWT_SECRET=
AUTH_BASE_URL=
BOOTSTRAP_MANAGER_EMAIL=

# Optional notification provider settings
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional S3-compatible customer media storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Required when scheduled maintenance reminders are enabled
REMINDER_CALLBACK_SECRET=
